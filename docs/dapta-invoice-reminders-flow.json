        "code_action": {
          "code": "const body=params.trigger?.body;\nconst uuid=/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;\nconst valid=body&&typeof body==='object'&&!Array.isArray(body)&&Object.keys(body).length===2&&\n Object.keys(body).every(k=>['delivery_id','authorization_token'].includes(k))&&\n typeof body.delivery_id==='string'&&uuid.test(body.delivery_id)&&\n typeof body.authorization_token==='string'&&uuid.test(body.authorization_token);\nmodule.exports=valid?{valid:'yes',deliveryId:body.delivery_id.toLowerCase(),payload:JSON.stringify({deliveryId:body.delivery_id.toLowerCase(),token:body.authorization_token})}:{valid:'no'};"
