        "code_action": {
          "code": "const expected=params.normalizar_entrada;\nconst denied=(uncertain)=>({allowed:'no',result:JSON.stringify({accepted:false,uncertain})});\nconst parsed=value=>{if(typeof value!=='string')return value;if(value.length>32768)return null;try{return JSON.parse(value);}catch{return null;}};\nlet root=parsed(params.autorizar_envio?.response);\nfor(let i=0;i<4&&root&&typeof root==='object'&&root.allowed===undefined;i++)root=parsed(root.response??root.body??root.data);\nif(!root||typeof root!=='object'||Array.isArray(root)){module.exports=denied(true);}\nelse if(root.allowed===false){module.exports=denied(false);}\nelse{\n const uuid=/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;\n const text=value=>typeof value==='string'&&value.trim()&&value.length<=300&&!/[\\u0000-\\u001f\\u007f]/.test(value);\n const recipient=typeof root.recipient==='string'?root.recipient:'';\n const date=typeof root.dueDate==='string'&&/^\\d{4}-\\d{2}-\\d{2}$/.test(root.dueDate)?new Date(root.dueDate+'T12:00:00Z'):null;\n const validDate=date&&Number.isFinite(date.getTime())&&date.toISOString().slice(0,10)===root.dueDate;\n const value=(typeof root.balance==='number'&&Number.isFinite(root.balance))||typeof root.balance==='string'?String(root.balance):'';\n const money=/^(0|[1-9]\\d{0,11})(?:\\.(\\d{1,2}))?$/.exec(value);\n const cents=money?BigInt(money[1])*100n+BigInt((money[2]||'').padEnd(2,'0')):0n;\n const valid=root.allowed===true&&typeof root.deliveryId==='string'&&uuid.test(root.deliveryId)&&\n root.deliveryId.toLowerCase()===expected.deliveryId&&/^\\+?573\\d{9}$/.test(recipient)&&\n text(root.number)&&text(root.provider)&&validDate&&money&&cents>0n&&cents<=99999999999999n;\n if(!valid){module.exports=denied(true);}\n else{\n  const whole=String(cents/100n).replace(/\\B(?=(\\d{3})+(?!\\d))/g,'.');\n  const fraction=String(cents%100n).padStart(2,'0');\n  const [year,month,day]=root.dueDate.split('-');\n  module.exports={allowed:'yes',deliveryId:expected.deliveryId,recipient:recipient.startsWith('+')?recipient:'+'+recipient,\n   numero_factura:root.number,proveedor:root.provider,fecha_vencimiento:day+'/'+month+'/'+year,\n   saldo_pendiente:'$ '+whole+(fraction==='00'?'':','+fraction)};\n }\n}"
        },
