      "childRef": "respR",
      "x": 240,
      "y": 820,
      "api_action": {
        "action_type": "code",
        "on_error": "stop",
        "code_action": {
          "code": "const context=params.validar_autorizacion;\nconst parsed=value=>{if(typeof value!=='string'||value.length>65536||!/^\\s*[\\[{]/.test(value))return value;try{return JSON.parse(value);}catch{return value;}};\nlet count=0,rejected=false;const seen=new Set(),receipts=new Set();\nconst populated=x=>x!==undefined&&x!==null&&x!==false&&x!==''&&!(Array.isArray(x)&&x.length===0);\nconst visit=(original,depth)=>{\n if(depth>8||count++>200){rejected=true;return;}\n const value=parsed(original);if(!value||typeof value!=='object'||seen.has(value))return;seen.add(value);\n if(value.ok===false||value.success===false||value.suppressed===true||value.scheduled===true||populated(value.error)||populated(value.errors)||['failed','error','rejected','suppressed','scheduled'].includes(String(value.status||'').toLowerCase()))rejected=true;\n if(value.success===true&&value.status==='sent'&&value.suppressed===false&&value.scheduled!==true&&typeof value.provider_message_id==='string'&&/^wamid\\.[A-Za-z0-9+/=_-]{8,500}$/.test(value.provider_message_id))receipts.add(value.provider_message_id);\n for(const child of Object.values(value))if(child&&(typeof child==='object'||typeof child==='string'))visit(child,depth+1);\n};\nvisit(params.enviar_recordatorio,0);\nconst accepted=context?.allowed==='yes'&&!rejected&&receipts.size===1;\nmodule.exports={result:JSON.stringify(accepted?{accepted:true,deliveryId:context.deliveryId,messageId:[...receipts][0]}:{accepted:false,uncertain:true})};"
        },
        "response": [
          {
            "variable_name": "result",
            "response_value_path": "result"
          }
        ]
