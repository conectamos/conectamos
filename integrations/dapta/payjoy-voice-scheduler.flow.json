          "code": "let d=params.autorizar_despacho?.response;\nif(typeof d==='string'){try{d=JSON.parse(d);}catch{throw new Error('Autorizacion de despacho invalida');}}\nconst now=Date.now();let allowed=false;\nif(d&&typeof d==='object'&&!Array.isArray(d)&&d.allowed===true&&!d.error&&d.ok!==false&&d.success!==false&&now>=Date.parse('2026-11-10T15:00:00.000Z')&&now<Date.parse('2026-11-10T15:30:00.000Z')){\n const expected=params.preparar_llamada;\n if(d.event_id!==expected.event_id||d.to_number!==expected.to_number||d.device_tag!==expected.device_tag||!/^\\+573\\d{9}$/.test(d.to_number)||!/^D[A-Z0-9]{5,31}$/.test(d.device_tag))throw new Error('Autorizacion no corresponde al contacto');\n allowed=true;\n}\nmodule.exports=allowed?{allowed:true,event_id:d.event_id,to_number:d.to_number,device_tag:d.device_tag}:{allowed:false};"
        },
        "response": [
