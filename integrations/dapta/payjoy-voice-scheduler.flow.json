      "id": "recPJ",
      "name": "Normalizar recibo",
      "type": "action",
      "parentRefs": [
        "calPJ"
      ],
      "childRef": "savPJ",
      "loopContextId": "lopPJ",
      "api_action": {
        "action_type": "code",
        "on_error": "stop",
        "code_action": {
          "code": "const native=params.llamada_payjoy||{};\nconst parse=v=>{if(typeof v!=='string')return v;try{return JSON.parse(v);}catch{return v;}};\nconst hasError=v=>v!==undefined&&v!==null&&v!==''&&v!==false&&(typeof v!=='object'||Object.keys(v).length>0);\nconst failed=(v,depth=0)=>{const p=parse(v);if(!p||typeof p!=='object')return false;if(depth>12)return true;if(Array.isArray(p))return p.some(x=>failed(x,depth+1));if(hasError(p.error)||hasError(p.errors)||hasError(p.node_errors)||p.ok===false||p.success===false||[p.call_status,p.status].some(x=>['error','failed','rejected','cancelled','canceled'].includes(String(x||'').toLowerCase())))return true;return Object.values(p).some(x=>failed(x,depth+1));};\nconst error=failed(native);let current=native.response;let callId=null;\nfor(let i=0;!error&&i<4;i++){current=parse(current);if(!current||typeof current!=='object'||Array.isArray(current))break;if(typeof current.call_id==='string'&&/^[A-Za-z0-9][A-Za-z0-9_-]{5,127}$/.test(current.call_id)){callId=current.call_id;break;}current=current.response??current.result??current.data;}\nconst payload={action:'receipt',event_token:params.preparar_llamada.event_token,accepted:!error&&Boolean(callId)};\nif(!error&&callId)payload.call_id=callId;else payload.error_code=error?'NATIVE_CALL_ERROR':'NATIVE_CALL_UNKNOWN';\nmodule.exports={payload:JSON.stringify(payload)};"
        },
        "response": [
          {
            "variable_name": "payload",
            "response_value_path": "payload"
          }
        ]
      }
