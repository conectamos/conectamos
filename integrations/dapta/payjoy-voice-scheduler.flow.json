      "type": "action",
      "parentRefs": [
        "clmPJ"
      ],
      "childRef": "lopPJ",
      "api_action": {
        "action_type": "code",
        "on_error": "stop",
        "code_action": {
          "code": "let d=params.reclamar_llamadas?.response;\nif(typeof d==='string'){try{d=JSON.parse(d);}catch{throw new Error('Respuesta de claim invalida');}}\nif(!d||typeof d!=='object'||Array.isArray(d)||d.ok===false||d.error||!Array.isArray(d.calls)||d.calls.length>7)throw new Error('Lote de llamadas invalido');\nconst ids=new Set();const phones=new Set();\nfor(const c of d.calls){\n if(!c||typeof c!=='object'||Array.isArray(c)||typeof c.event_id!=='string'||!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(c.event_id)||typeof c.event_token!=='string'||c.event_token.length<32||c.event_token.length>2048||typeof c.to_number!=='string'||!/^\\+573\\d{9}$/.test(c.to_number)||typeof c.device_tag!=='string'||!/^D[A-Z0-9]{5,31}$/.test(c.device_tag)||ids.has(c.event_id)||phones.has(c.to_number))throw new Error('Contacto de llamada invalido');\n ids.add(c.event_id);phones.add(c.to_number);\n}\nmodule.exports={calls:d.calls,claimed_count:d.calls.length};"
        },
        "response": [
